<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/alana_bg"
    android:orientation="vertical">

    <include layout="@layout/view_form_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView style="@style/Alana.SectionLabel" android:text="Nome da turma" />
            <EditText
                android:id="@+id/etNomeTurma"
                style="@style/Alana.Input"
                android:hint="Ex: Violão 01"
                android:importantForAutofill="no"
                android:inputType="textCapSentences" />

            <TextView style="@style/Alana.FormLabel" android:text="Professor responsável" />
            <Spinner
                android:id="@+id/spProfessor"
                style="@style/Alana.Spinner" />

            <TextView style="@style/Alana.FormLabel" android:text="Dia da semana" />
            <Spinner
                android:id="@+id/spDia"
                style="@style/Alana.Spinner" />

            <TextView style="@style/Alana.FormLabel" android:text="Horário" />
            <EditText
                android:id="@+id/etHorario"
                style="@style/Alana.Input"
                android:clickable="true"
                android:cursorVisible="false"
                android:focusable="false"
                android:hint="00:00"
                android:importantForAutofill="no"
                android:inputType="none" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCriarTurma"
                style="@style/Alana.ButtonPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Criar turma" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
