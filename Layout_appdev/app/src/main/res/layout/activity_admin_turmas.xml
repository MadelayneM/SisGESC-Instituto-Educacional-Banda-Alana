<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/alana_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/alana_white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="20dp">

        <TextView
            style="@style/Alana.Title"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="Turmas" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNovaTurma"
            style="@style/Alana.ButtonSmall"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Nova turma" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/alana_divider" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTurmas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    <include layout="@layout/view_admin_bottom_nav" />
</LinearLayout>
