<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/adminAlterarSenha"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/alana_bg"
    android:orientation="vertical">

    <include layout="@layout/view_form_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView style="@style/Alana.SectionLabel" android:text="Senha atual" />
            <EditText
                android:id="@+id/etSenhaAtual"
                style="@style/Alana.Input"
                android:hint="Digite sua senha atual"
                android:importantForAutofill="no"
                android:inputType="textPassword" />

            <TextView style="@style/Alana.FormLabel" android:text="Nova senha" />
            <EditText
                android:id="@+id/etNovaSenha"
                style="@style/Alana.Input"
                android:hint="Mínimo de 6 caracteres"
                android:importantForAutofill="no"
                android:inputType="textPassword" />

            <TextView style="@style/Alana.FormLabel" android:text="Confirmar nova senha" />
            <EditText
                android:id="@+id/etConfirmarSenha"
                style="@style/Alana.Input"
                android:hint="Repita a nova senha"
                android:importantForAutofill="no"
                android:inputType="textPassword" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSalvarSenha"
                style="@style/Alana.ButtonPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Alterar senha" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>