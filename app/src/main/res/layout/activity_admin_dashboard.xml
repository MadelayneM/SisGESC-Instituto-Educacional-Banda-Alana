<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/alana_white"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/alana_white"
            android:orientation="vertical">

            <!-- Cabeçalho -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="24dp"
                android:paddingEnd="20dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bem-vindo,"
                    android:textColor="@color/alana_text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvNomeUsuario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Administrador! 🎓"
                    android:textColor="@color/alana_text"
                    android:textSize="24sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/alana_divider" />

            <!-- VISÃO GERAL -->
            <TextView
                style="@style/Alana.SectionLabel"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:text="Visão geral" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="14dp"
                android:orientation="horizontal">

                <!-- Alunos -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Alana.Card"
                    android:id="@+id/cardAlunos"

                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="6dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            style="@style/Alana.StatIcon"
                            android:backgroundTint="@color/alana_blue_bg"
                            android:text="👥" />

                        <TextView
                            android:id="@+id/tvTotalAlunos"
                            style="@style/Alana.StatNumber"
                            android:text="120"
                            android:textColor="@color/alana_blue" />

                        <TextView
                            style="@style/Alana.StatLabel"
                            android:text="Alunos" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Turmas -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTurmas"
                    style="@style/Alana.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="6dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            style="@style/Alana.StatIcon"
                            android:backgroundTint="@color/alana_green_bg"
                            android:text="📚" />

                        <TextView
                            android:id="@+id/tvTotalTurmas"
                            style="@style/Alana.StatNumber"
                            android:text="12"
                            android:textColor="@color/alana_green" />

                        <TextView
                            style="@style/Alana.StatLabel"
                            android:text="Turmas" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:orientation="horizontal">

                <!-- Professores -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardProfessores"
                    style="@style/Alana.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="6dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            style="@style/Alana.StatIcon"
                            android:backgroundTint="@color/alana_purple_bg"
                            android:text="🧑‍🏫" />

                        <TextView
                            android:id="@+id/tvTotalProfessores"
                            style="@style/Alana.StatNumber"
                            android:text="15"
                            android:textColor="@color/alana_purple" />

                        <TextView
                            style="@style/Alana.StatLabel"
                            android:text="Professores" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Frequência -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardFrequncia"
                    style="@style/Alana.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="6dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            style="@style/Alana.StatIcon"
                            android:backgroundTint="@color/alana_yellow_bg"
                            android:text="✅" />

                        <TextView
                            android:id="@+id/tvFrequenciaGeral"
                            style="@style/Alana.StatNumber"
                            android:text="89%"
                            android:textColor="@color/alana_yellow" />

                        <TextView
                            style="@style/Alana.StatLabel"
                            android:text="Frequência" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- GERENCIAMENTO -->
            <TextView
                style="@style/Alana.SectionLabel"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:text="Gerenciamento" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="14dp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCadastrarAluno"
                    style="@style/Alana.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="6dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            style="@style/Alana.ActionIcon"
                            android:text="👤" />

                        <TextView
                            style="@style/Alana.ActionText"
                            android:text="Cadastrar aluno" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardNovaTurma"
                    style="@style/Alana.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="6dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            style="@style/Alana.ActionIcon"
                            android:text="📖" />

                        <TextView
                            style="@style/Alana.ActionText"
                            android:text="Nova turma" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCadastrarProfessor"
                    style="@style/Alana.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="6dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            style="@style/Alana.ActionIcon"
                            android:text="🎓" />

                        <TextView
                            style="@style/Alana.ActionText"
                            android:text="Cadastrar professor" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardConsultarFrequencia"
                    style="@style/Alana.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="6dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            style="@style/Alana.ActionIcon"
                            android:text="📊" />

                        <TextView
                            style="@style/Alana.ActionText"
                            android:text="Consultar frequência" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>


            </LinearLayout>

            <!-- CARD DE GERENCIAR AVISOS (Largura Total - Linha Única) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAvisos"
                style="@style/Alana.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <!-- 1. Ícone de Avisos -->
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/outline_circle_notifications_24" />

                    <!-- 2. Texto "Gerenciar avisos" (ocupa o espaço central) -->
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:text="Gerenciar avisos"
                        android:textColor="@color/alana_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- 3. Botão de Adicionar Aviso -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddAvisoCard"
                        style="@style/Alana.ButtonPrimary"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="+ Add"
                        android:textSize="12sp"
                        app:cornerRadius="20dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>






            <!-- ALUNOS RECENTES -->
            <TextView
                style="@style/Alana.SectionLabel"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:text="Alunos recentes" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Alana.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="24dp"
                android:clickable="false"
                android:focusable="false">

                <LinearLayout
                    android:id="@+id/llAlunosRecentes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/divider_list"
                    android:orientation="vertical"
                    android:showDividers="middle" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/view_admin_bottom_nav" />
</LinearLayout>
