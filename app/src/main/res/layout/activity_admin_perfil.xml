<?xml version="1.0" encoding="utf-8"?>
<!-- Tela Perfil do Administrador (mesma estrutura do Perfil do Aluno e do Professor).
     Dados: AdminRepository.buscarPerfil (ainda será criado pelo back-end) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAFAFA">

    <!-- CABEÇALHO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="53dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:background="#FFFFFF">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Perfil"
            android:textColor="#222222"
            android:textSize="16sp" />

    </LinearLayout>

    <!-- CONTEÚDO ROLÁVEL -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:paddingTop="18dp"
            android:paddingBottom="12dp">

            <!-- FOTO: getFotoUrl(). O círculo amarelo aparece quando não há foto. -->
            <ImageView
                android:id="@+id/imgPerfilAdmin"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/bg_foto_aluno"
                android:scaleType="centerCrop"
                android:contentDescription="Foto do administrador" />

            <!-- NOME: getNomeCompleto() -->
            <TextView
                android:id="@+id/txtNomePerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                tools:text="Ana Souza Lima"
                android:textColor="#222222"
                android:textSize="14sp" />

            <!-- IDENTIFICAÇÃO: getCargo(), ex.: Gestor -->
            <TextView
                android:id="@+id/txtTipoPerfil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="22dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="5dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:gravity="center"
                android:background="@drawable/bg_tipo_aluno"
                tools:text="Gestor"
                android:textColor="#B38B00"
                android:textSize="10sp" />

            <!-- DADOS PESSOAIS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_card_branco"
                android:elevation="1dp"
                android:clipToOutline="true">

                <!-- E-MAIL: getEmail() -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="51dp"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="E-MAIL"
                        android:textColor="#AAAAAA"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/txtEmailPerfil"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        tools:text="ana.lima@bandaalana.org"
                        android:textColor="#333333"
                        android:textSize="11sp" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEEEEE" />

                <!-- TELEFONE: getTelefoneFormatado() -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="49dp"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TELEFONE"
                        android:textColor="#AAAAAA"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/txtTelefonePerfil"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        tools:text="(11) 991110001"
                        android:textColor="#333333"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- BOTÃO EDITAR DADOS: abre dialog_editar_dados_admin.xml -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnEditarDados"
                android:layout_width="match_parent"
                android:layout_height="39dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/bg_botao_contorno_amarelo"
                android:backgroundTint="@null"
                android:text="Editar dados"
                android:textColor="#D6A900"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:stateListAnimator="@null" />

            <!-- BOTÃO ALTERAR SENHA: abre dialog_alterar_senha_admin.xml -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnAlterarSenha"
                android:layout_width="match_parent"
                android:layout_height="39dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_botao_contorno_cinza"
                android:backgroundTint="@null"
                android:text="Alterar senha"
                android:textColor="#888888"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:stateListAnimator="@null" />

            <!-- BOTÃO SAIR -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSairPerfil"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_botao_sair"
                android:backgroundTint="@null"
                android:text="Sair"
                android:textColor="#F04444"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:stateListAnimator="@null" />

        </LinearLayout>

    </ScrollView>

    <!-- MENU INFERIOR -->
    <include layout="@layout/menu_inferior_admin" />

</LinearLayout>
