<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Cabeçalho -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:background="#FFFFFF">

            <ImageButton
                android:id="@+id/btnVoltar"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_media_previous"
                android:contentDescription="Voltar" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enviar aviso"
                android:textSize="23sp"
                android:textColor="#222222"
                android:textStyle="bold"
                android:layout_marginStart="15dp"/>

        </LinearLayout>

        <!-- Conteúdo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <!-- Informação -->

            <!-- Turma -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="30dp"
                android:background="#FFF8DF"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📢"
                    android:textSize="32sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_weight="1"
                    android:text="Escreva aqui o aviso que será enviado para os alunos desta turma."
                    android:textColor="#555555"
                    android:textSize="15sp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Turma"
                android:textSize="18sp"
                android:textColor="#444444"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:id="@+id/txtNomeTurma"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="18dp"
                android:text="Musicalização 01"
                android:textSize="17sp"
                android:textColor="#222222" />

            <!-- Mensagem -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mensagem"
                android:textSize="18sp"
                android:textColor="#444444"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="10dp"/>

            <EditText
                android:id="@+id/edtAviso"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:gravity="top|start"
                android:padding="18dp"
                android:hint="Digite o aviso aqui..."
                android:textSize="16sp"
                android:textColor="#333333"
                android:textColorHint="#999999"
                android:maxLength="300"
                android:inputType="textMultiLine"/>

            <!-- Contador -->
            <TextView
                android:id="@+id/txtContador"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="0/300"
                android:textColor="#888888"
                android:textSize="14sp"
                android:layout_marginTop="5dp"/>

            <!-- Botão enviar -->
            <Button
                android:id="@+id/btnEnviarAviso"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="➤  Enviar aviso"
                android:textSize="18sp"
                android:textColor="#333333"
                android:backgroundTint="#FFC400"
                android:layout_marginTop="30dp"
                android:textAllCaps="false"/>

            <!-- Botão cancelar -->
            <Button
                android:id="@+id/btnCancelar"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:text="Cancelar"
                android:textSize="17sp"
                android:textColor="#555555"
                android:backgroundTint="#FFFFFF"
                android:layout_marginTop="15dp"
                android:textAllCaps="false"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>