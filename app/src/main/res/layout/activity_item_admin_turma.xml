<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Alana.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="20dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="20dp"
    android:layout_marginBottom="6dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvNomeTurma"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/alana_text"
                android:textSize="17sp"
                tools:text="Musicalização 01" />

            <TextView
                android:id="@+id/tvQtdAlunos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/alana_yellow"
                android:textSize="22sp"
                tools:text="12" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="alunos matriculados"
            android:textColor="@color/alana_text_secondary"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="@color/alana_divider" />

        <!-- Professor em uma linha inteira (nomes longos não encostam no dia);
             horário e dia da semana lado a lado na linha de baixo -->
        <TextView
            android:id="@+id/tvProfessor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/alana_text_secondary"
            android:textSize="13sp"
            tools:text="🧑‍🏫  Thiago Barbosa Cardoso" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvHorario"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/alana_text_secondary"
                android:textSize="13sp"
                tools:text="⏰  14:00 – 15:30" />

            <TextView
                android:id="@+id/tvDia"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/alana_text_secondary"
                android:textSize="13sp"
                tools:text="📅  Quarta-feira" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
