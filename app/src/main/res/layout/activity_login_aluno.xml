<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAFAFA">

    <!-- CABEÇALHO BRANCO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="191dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#FFFFFF"
        android:padding="16dp">

        <!-- LOGO PROVISÓRIO -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="𝄞"
                android:textColor="#F5D000"
                android:textSize="43sp"
                android:fontFamily="serif"
                android:includeFontPadding="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Banda\nAlana"
                android:textColor="#171717"
                android:textSize="19sp"
                android:textStyle="bold"
                android:fontFamily="cursive"
                android:lineSpacingMultiplier="0.8" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:text="Gestão e acompanhamento escolar"
            android:textColor="#777777"
            android:textSize="12sp"
            android:gravity="center" />

        <!-- IDENTIFICAÇÃO DO PERFIL -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="@drawable/bg_perfil_aluno"
            android:text="Aluno / Responsável"
            android:textColor="#B78B00"
            android:textSize="10sp"
            android:gravity="center" />

    </LinearLayout>

    <!-- ÁREA DE LOGIN -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="17dp"
        android:paddingBottom="12dp">

        <!-- E-MAIL OU USUÁRIO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="E-MAIL OU USUÁRIO"
            android:textColor="#777777"
            android:textSize="10sp"
            android:letterSpacing="0.04"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/edtEmailAluno"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/bg_campo_login"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:hint="seu@email.com"
            android:textColor="#333333"
            android:textColorHint="#999999"
            android:textSize="11sp"
            android:singleLine="true"
            android:inputType="textEmailAddress"
            android:autofillHints="username" />

        <!-- SENHA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:layout_marginBottom="6dp"
            android:text="SENHA"
            android:textColor="#777777"
            android:textSize="10sp"
            android:letterSpacing="0.04" />

        <EditText
            android:id="@+id/edtSenhaAluno"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/bg_campo_login"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:hint="••••••••"
            android:textColor="#333333"
            android:textColorHint="#999999"
            android:textSize="12sp"
            android:singleLine="true"
            android:inputType="textPassword"
            android:autofillHints="password" />

        <!-- ENTRAR -->

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnEntrarAluno"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_botao_amarelo"
            android:backgroundTint="@null"
            android:text="Entrar"
            android:textColor="#171717"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:stateListAnimator="@null" />


        <!-- RECUPERAÇÃO DE SENHA -->
        <TextView
            android:id="@+id/txtEsqueciSenha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:padding="4dp"
            android:text="Esqueci minha senha"
            android:textColor="#E6A900"
            android:textSize="11sp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />

        <!-- ESPAÇO PARA MANTER O RODAPÉ ABAIXO -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- VOLTAR À SELEÇÃO -->
        <LinearLayout
            android:id="@+id/btnVoltarPerfil"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="←"
                android:textColor="#777777"
                android:textSize="22sp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Voltar à seleção de perfil"
                android:textColor="#777777"
                android:textSize="11sp" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="12dp" />

    </LinearLayout>

</LinearLayout>
