<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:text="Bem-vindo de volta,"
            android:textSize="14sp"
            android:textColor="#999999"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:text="João! 👋"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp" />

        <TextView
            android:text="MINHAS TURMAS"
            android:textSize="12sp"
            android:textColor="#999999"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" />

        <!-- Turma 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="15dp"
            android:background="@drawable/card_background"
            android:layout_marginBottom="12dp">

            <TextView
                android:text="Musicalização 01"
                android:textSize="17sp"
                android:textColor="#333333"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:text="12 alunos • Sala 02"
                android:textSize="13sp"
                android:textColor="#999999"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp" />

            <TextView
                android:text="📅 Quarta-feira • 🕒 14:00"
                android:textSize="13sp"
                android:textColor="#666666"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <Button
                android:id="@+id/btnChamada"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Fazer chamada"
                android:textColor="#FFFFFF"
                android:backgroundTint="#F2C900"
                android:layout_marginTop="10dp" />

            <Button
                android:id="@+id/btnVerAlunos"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Ver alunos"
                android:textColor="#555555"
                android:backgroundTint="#F2F2F2" />

        </LinearLayout>

        <!-- Turma 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="15dp"
            android:background="@drawable/card_background"
            android:layout_marginBottom="12dp">

            <TextView
                android:text="Violão 02"
                android:textSize="17sp"
                android:textColor="#333333"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:text="10 alunos • Sala 01"
                android:textSize="13sp"
                android:textColor="#999999"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp" />

            <TextView
                android:text="📅 Sexta-feira • 🕒 15:00"
                android:textSize="13sp"
                android:textColor="#666666"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <Button
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Fazer chamada"
                android:textColor="#FFFFFF"
                android:backgroundTint="#F2C900"
                android:layout_marginTop="10dp" />

            <Button
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Ver alunos"
                android:textColor="#555555"
                android:backgroundTint="#F2F2F2" />

        </LinearLayout>

        <!-- Turma 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="15dp"
            android:background="@drawable/card_background">

            <TextView
                android:text="Percussão 01"
                android:textSize="17sp"
                android:textColor="#333333"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:text="8 alunos • Sala 03"
                android:textSize="13sp"
                android:textColor="#999999"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp" />

            <TextView
                android:text="📅 Terça-feira • 🕒 10:00"
                android:textSize="13sp"
                android:textColor="#666666"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <Button
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Fazer chamada"
                android:textColor="#FFFFFF"
                android:backgroundTint="#F2C900"
                android:layout_marginTop="10dp" />

            <Button
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Ver alunos"
                android:textColor="#555555"
                android:backgroundTint="#F2F2F2" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
