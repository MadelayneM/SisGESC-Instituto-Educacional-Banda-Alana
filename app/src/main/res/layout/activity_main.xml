<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">


<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAFAFA">

    <!-- CABEÇALHO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="235dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#FFFFFF"
        android:padding="20dp">

        <!-- Logo provisório: substituir pela imagem oficial -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="𝄞"
                android:textColor="#F5D000"
                android:textSize="64sp"
                android:fontFamily="serif"
                android:includeFontPadding="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Banda\nAlana"
                android:textColor="#171717"
                android:textSize="27sp"
                android:textStyle="bold"
                android:fontFamily="cursive"
                android:lineSpacingMultiplier="0.8" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Gestão e acompanhamento escolar"
            android:textColor="#777777"
            android:textSize="14sp"
            android:gravity="center" />

    </LinearLayout>

    <!-- CONTEÚDO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACESSAR COMO:"
            android:textColor="#777777"
            android:textSize="14sp"
            android:letterSpacing="0.04"
            android:layout_marginBottom="16dp" />

        <!-- OPÇÃO 1: ALUNO / RESPONSÁVEL -->
        <LinearLayout
            android:id="@+id/cardAluno"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/white"
            android:paddingStart="16dp"
            android:paddingEnd="14dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:text="🎵"
                android:textSize="27sp"
                android:gravity="center" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Aluno / Responsável"
                    android:textColor="#171717"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Consulte frequência, turma e dados"
                    android:textColor="#777777"
                    android:textSize="12sp" />

            </LinearLayout>

            <TextView
                android:layout_width="20dp"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#BDBDBD"
                android:textSize="28sp"
                android:gravity="center" />

        </LinearLayout>

        <!-- OPÇÃO 2: PROFESSOR / MONITOR -->
        <LinearLayout
            android:id="@+id/cardProfessor"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/white"
            android:paddingStart="16dp"
            android:paddingEnd="14dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:text="🎸"
                android:textSize="27sp"
                android:gravity="center" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Professor / Monitor"
                    android:textColor="#171717"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Gerencie turmas e registre presença"
                    android:textColor="#777777"
                    android:textSize="12sp" />

            </LinearLayout>

            <TextView
                android:layout_width="20dp"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#BDBDBD"
                android:textSize="28sp"
                android:gravity="center" />

        </LinearLayout>

        <!-- OPÇÃO 3: GESTOR / ADMINISTRADOR -->
        <LinearLayout
            android:id="@+id/cardGestor"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/white"
            android:paddingStart="16dp"
            android:paddingEnd="14dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <TextView
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:text="🎓"
                android:textSize="27sp"
                android:gravity="center" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Gestor / Administrador"
                    android:textColor="#171717"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Administre alunos, turmas e equipe"
                    android:textColor="#777777"
                    android:textSize="12sp" />

            </LinearLayout>

            <TextView
                android:layout_width="20dp"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#BDBDBD"
                android:textSize="28sp"
                android:gravity="center" />

        </LinearLayout>

        <!-- ESPAÇO FLEXÍVEL -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- RODAPÉ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎵 Instituto Alana • Escola de Música"
            android:textColor="#B0B0B0"
            android:textSize="12sp"
            android:gravity="center"
            android:paddingBottom="24dp" />

    </LinearLayout>

</LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>