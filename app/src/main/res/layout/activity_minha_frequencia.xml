<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAFAFA">

    <!-- CABEÇALHO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="69dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:background="#FFFFFF">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Minha Frequência"
            android:textColor="#222222"
            android:textSize="16sp" />

    </LinearLayout>

    <!-- CONTEÚDO -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:paddingTop="16dp"
            android:paddingBottom="10dp">

            <!-- RESUMO DA FREQUÊNCIA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="15dp"
                android:background="@drawable/bg_card_branco"
                android:elevation="2dp">

                <!-- PORCENTAGEM -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtPercentualFrequencia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="92%"
                        android:textColor="#35B653"
                        android:textSize="27sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="de presença"
                        android:textColor="#333333"
                        android:textSize="10sp" />

                </LinearLayout>

                <!-- TOTAIS -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:gravity_horizontal="end">

                    <TextView
                        android:id="@+id/txtTotalPresencas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="23"
                        android:textColor="#35B653"
                        android:textSize="14sp"
                        android:gravity="end" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Presenças"
                        android:textColor="#888888"
                        android:textSize="8sp"
                        android:gravity="end" />

                    <TextView
                        android:id="@+id/txtTotalAusencias"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="2"
                        android:textColor="#FF4444"
                        android:textSize="14sp"
                        android:gravity="end" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ausências"
                        android:textColor="#888888"
                        android:textSize="8sp"
                        android:gravity="end" />

                    <TextView
                        android:id="@+id/txtTotalAulas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="25"
                        android:textColor="#222222"
                        android:textSize="14sp"
                        android:gravity="end" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total"
                        android:textColor="#888888"
                        android:textSize="8sp"
                        android:gravity="end" />

                </LinearLayout>

            </LinearLayout>

            <!-- HISTÓRICO DE AULAS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_branco"
                android:elevation="1dp"
                android:clipToOutline="true">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:text="Histórico de aulas"
                    android:textColor="#333333"
                    android:textSize="11sp" />

                <!-- AULA 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_ponto_presente" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="9dp"
                        android:text="25/08 — Segunda"
                        android:textColor="#333333"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="50dp"
                        android:layout_height="19dp"
                        android:gravity="center"
                        android:background="@drawable/bg_status_presente"
                        android:text="Presente"
                        android:textColor="#27864A"
                        android:textSize="8sp" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEEEEE" />

                <!-- AULA 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_ponto_presente" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="9dp"
                        android:text="28/08 — Quinta"
                        android:textColor="#333333"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="50dp"
                        android:layout_height="19dp"
                        android:gravity="center"
                        android:background="@drawable/bg_status_presente"
                        android:text="Presente"
                        android:textColor="#27864A"
                        android:textSize="8sp" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEEEEE" />

                <!-- AULA 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_ponto_ausente" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="9dp"
                        android:text="01/09 — Segunda"
                        android:textColor="#333333"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="50dp"
                        android:layout_height="19dp"
                        android:gravity="center"
                        android:background="@drawable/bg_status_ausente"
                        android:text="Ausente"
                        android:textColor="#D83232"
                        android:textSize="8sp" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEEEEE" />

                <!-- AULA 4 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_ponto_presente" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="9dp"
                        android:text="04/09 — Quinta"
                        android:textColor="#333333"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="50dp"
                        android:layout_height="19dp"
                        android:gravity="center"
                        android:background="@drawable/bg_status_presente"
                        android:text="Presente"
                        android:textColor="#27864A"
                        android:textSize="8sp" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEEEEE" />

                <!-- AULA 5 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_ponto_presente" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="9dp"
                        android:text="08/09 — Segunda"
                        android:textColor="#333333"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="50dp"
                        android:layout_height="19dp"
                        android:gravity="center"
                        android:background="@drawable/bg_status_presente"
                        android:text="Presente"
                        android:textColor="#27864A"
                        android:textSize="8sp" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEEEEE" />

                <!-- AULA 6 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_ponto_presente" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="9dp"
                        android:text="11/09 — Quinta"
                        android:textColor="#333333"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="50dp"
                        android:layout_height="19dp"
                        android:gravity="center"
                        android:background="@drawable/bg_status_presente"
                        android:text="Presente"
                        android:textColor="#27864A"
                        android:textSize="8sp" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEEEEE" />

                <!-- AULA 7 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_ponto_ausente" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="9dp"
                        android:text="15/09 — Segunda"
                        android:textColor="#333333"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="50dp"
                        android:layout_height="19dp"
                        android:gravity="center"
                        android:background="@drawable/bg_status_ausente"
                        android:text="Ausente"
                        android:textColor="#D83232"
                        android:textSize="8sp" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEEEEE" />

                <!-- AULA 8 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_ponto_presente" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="9dp"
                        android:text="18/09 — Quinta"
                        android:textColor="#333333"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="50dp"
                        android:layout_height="19dp"
                        android:gravity="center"
                        android:background="@drawable/bg_status_presente"
                        android:text="Presente"
                        android:textColor="#27864A"
                        android:textSize="8sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- MENU INFERIOR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FFFFFF"
        android:elevation="5dp">

        <!-- INÍCIO -->
        <LinearLayout
            android:id="@+id/navInicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌂"
                android:textColor="#E7D78B"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Início"
                android:textColor="#C7B77C"
                android:textSize="8sp" />

        </LinearLayout>

        <!-- TURMA -->
        <LinearLayout
            android:id="@+id/navTurma"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▤"
                android:textColor="#E7D78B"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Turma"
                android:textColor="#C7B77C"
                android:textSize="8sp" />

        </LinearLayout>

        <!-- FREQUÊNCIA SELECIONADA -->
        <LinearLayout
            android:id="@+id/navFrequencia"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓"
                android:textColor="#F5C900"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Frequência"
                android:textColor="#D6AA00"
                android:textSize="8sp" />

        </LinearLayout>

        <!-- PERFIL -->
        <LinearLayout
            android:id="@+id/navPerfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="♟"
                android:textColor="#E7D78B"
                android:textSize="17sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Perfil"
                android:textColor="#C7B77C"
                android:textSize="8sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
