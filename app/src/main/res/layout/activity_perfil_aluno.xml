<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAFAFA">

    <!-- CABEÇALHO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="53dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:background="#FFFFFF">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Perfil"
            android:textColor="#222222"
            android:textSize="16sp" />

    </LinearLayout>

    <!-- CONTEÚDO ROLÁVEL -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:paddingTop="18dp"
            android:paddingBottom="12dp">

            <!-- FOTO DO ALUNO -->
            <ImageView
                android:id="@+id/imgPerfilAluno"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/bg_foto_aluno"
                android:scaleType="centerCrop"
                android:contentDescription="Foto da aluna" />

            <!-- NOME -->
            <TextView
                android:id="@+id/txtNomePerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Maria Aparecida Silva"
                android:textColor="#222222"
                android:textSize="14sp" />

            <!-- IDENTIFICAÇÃO -->
            <TextView
                android:id="@+id/txtTipoPerfil"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="5dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center"
                android:background="@drawable/bg_tipo_aluno"
                android:text="Aluna"
                android:textColor="#B38B00"
                android:textSize="10sp" />

            <!-- DADOS PESSOAIS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_card_branco"
                android:elevation="1dp"
                android:clipToOutline="true">

                <!-- E-MAIL -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="51dp"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="E-MAIL"
                        android:textColor="#AAAAAA"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/txtEmailPerfil"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="maria.silva@alana.org"
                        android:textColor="#333333"
                        android:textSize="11sp" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEEEEE" />

                <!-- TELEFONE -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="49dp"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TELEFONE"
                        android:textColor="#AAAAAA"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/txtTelefonePerfil"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="(11) 91234-5678"
                        android:textColor="#333333"
                        android:textSize="11sp" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEEEEE" />

                <!-- RESPONSÁVEL -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RESPONSÁVEL"
                        android:textColor="#AAAAAA"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/txtResponsavelPerfil"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Ana Paula Silva"
                        android:textColor="#333333"
                        android:textSize="11sp" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEEEEE" />

                <!-- TELEFONE DO RESPONSÁVEL -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="49dp"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TEL. RESPONSÁVEL"
                        android:textColor="#AAAAAA"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/txtTelefoneResponsavel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="(11) 98765-4321"
                        android:textColor="#333333"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- BOTÃO EDITAR DADOS -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnEditarDados"
                android:layout_width="match_parent"
                android:layout_height="39dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/bg_botao_contorno_amarelo"
                app:backgroundTint="@null"
                android:text="Editar dados"
                android:textColor="#D6A900"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:stateListAnimator="@null" />

            <!-- BOTÃO ALTERAR SENHA -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnAlterarSenha"
                android:layout_width="match_parent"
                android:layout_height="39dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_botao_contorno_cinza"
                app:backgroundTint="@null"
                android:text="Alterar senha"
                android:textColor="#888888"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:stateListAnimator="@null" />

            <!-- BOTÃO SAIR -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSairPerfil"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_botao_sair"
                app:backgroundTint="@null"
                android:text="Sair"
                android:textColor="#F04444"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:stateListAnimator="@null" />

        </LinearLayout>

    </ScrollView>

    <!-- MENU INFERIOR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FFFFFF"
        android:elevation="5dp">

        <!-- INÍCIO -->
        <LinearLayout
            android:id="@+id/navInicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌂"
                android:textColor="#E7D78B"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Início"
                android:textColor="#C7B77C"
                android:textSize="8sp" />

        </LinearLayout>

        <!-- TURMA -->
        <LinearLayout
            android:id="@+id/navTurma"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▤"
                android:textColor="#E7D78B"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Turma"
                android:textColor="#C7B77C"
                android:textSize="8sp" />

        </LinearLayout>

        <!-- FREQUÊNCIA -->
        <LinearLayout
            android:id="@+id/navFrequencia"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓"
                android:textColor="#E7D78B"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Frequência"
                android:textColor="#C7B77C"
                android:textSize="8sp" />

        </LinearLayout>

        <!-- PERFIL SELECIONADO -->
        <LinearLayout
            android:id="@+id/navPerfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="♟"
                android:textColor="#F5C900"
                android:textSize="17sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Perfil"
                android:textColor="#D6AA00"
                android:textSize="8sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>