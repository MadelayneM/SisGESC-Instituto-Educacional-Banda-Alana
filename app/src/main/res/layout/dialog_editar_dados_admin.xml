<?xml version="1.0" encoding="utf-8"?>
<!-- Conteúdo da janela "Editar dados" do Perfil do Administrador.
     Pensado para um AlertDialog: os botões Salvar e Cancelar são os do próprio dialog.
     Valores atuais: AdminRepository.buscarPerfil (ainda será criado)
     Salvar: AdminRepository.atualizarEmail e AdminRepository.atualizarTelefone -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <!-- E-MAIL -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="E-MAIL"
            android:textColor="#AAAAAA"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtEmail"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:autofillHints="emailAddress"
            android:background="@drawable/card_background"
            android:hint="nome@exemplo.org"
            android:inputType="textEmailAddress"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="#333333"
            android:textColorHint="#AAAAAA"
            android:textSize="14sp" />

        <!-- TELEFONE: DDD e número lado a lado -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp"
            android:text="TELEFONE"
            android:textColor="#AAAAAA"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/edtDdd"
                android:layout_width="70dp"
                android:layout_height="46dp"
                android:background="@drawable/card_background"
                android:gravity="center"
                android:hint="DDD"
                android:inputType="number"
                android:maxLength="2"
                android:singleLine="true"
                android:textColor="#333333"
                android:textColorHint="#AAAAAA"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/edtNumeroTelefone"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:autofillHints="phoneNational"
                android:background="@drawable/card_background"
                android:hint="Número (só dígitos)"
                android:inputType="phone"
                android:maxLength="9"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textColor="#333333"
                android:textColorHint="#AAAAAA"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- TIPO DO TELEFONE: opções do enum tipo_telefone: Celular, Residencial, Comercial -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp"
            android:text="TIPO DO TELEFONE"
            android:textColor="#AAAAAA"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spnTipoTelefone"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/card_background"
            android:paddingStart="6dp"
            android:paddingEnd="6dp" />

    </LinearLayout>

</ScrollView>
