<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/adminAvisos"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/alana_bg"
    android:orientation="vertical">
    <!-- Cabeçalho -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/alana_white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/btnVoltar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Voltar"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            style="@style/Alana.Title"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Gerenciar Avisos" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAbrirNovoAviso"
            style="@style/Alana.ButtonSmall"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="+ Novo" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/alana_divider" />

    <!-- Formulário de Novo Aviso -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardNovoAviso"
        style="@style/Alana.Card"
        android:layout_width="match_parent"
        android:visibility="gone"
        android:layout_height="wrap_content"
        android:layout_margin="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/Alana.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOVO COMUNICADO" />

            <EditText
                android:id="@+id/etTituloAviso"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_search"
                android:hint="Título do aviso (ex: Reunião de pais)"
                android:inputType="textCapSentences"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/alana_text"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etDescricaoAviso"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_search"
                android:gravity="top|start"
                android:hint="Escreva a mensagem detalhada..."
                android:inputType="textMultiLine|textCapSentences"
                android:padding="12dp"
                android:textColor="@color/alana_text"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPublicarAviso"
                style="@style/Alana.ButtonSmall"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:text="Publicar Aviso" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelarAviso"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:text="Cancelar"
                android:textColor="@color/alana_text" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        style="@style/Alana.SectionLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="8dp"
        android:text="AVISOS PUBLICADOS" />

    <!-- Lista de Avisos -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAvisosAdmin"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

</LinearLayout>