<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivAvatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:padding="2dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_avatar_placeholder"
        app:shapeAppearanceOverlay="@style/Alana.Circle"
        app:strokeColor="@color/alana_yellow"
        app:strokeWidth="2dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Maria Silva"
            android:textColor="@color/alana_text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvTurma"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Musicalização 01"
            android:textColor="@color/alana_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- No Adapter, troque o backgroundTint e a cor do texto conforme o status:
         Ativo:    tint alana_status_ativo_bg    / texto alana_status_ativo_text
         Inativo:  tint alana_status_inativo_bg  / texto alana_status_inativo_text -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chip"
        android:backgroundTint="@color/alana_status_ativo_bg"
        android:paddingStart="10dp"
        android:paddingTop="3dp"
        android:paddingEnd="10dp"
        android:paddingBottom="3dp"
        android:text="Ativo"
        android:textColor="@color/alana_status_ativo_text"
        android:textSize="12sp" />
</LinearLayout>
