<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAFAFA">

    <!-- CABEÇALHO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="92dp"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#FFFFFF">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bem-vindo(a) de volta,"
            android:textColor="#777777"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/txtNomeBoasVindas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Maria! 👋"
            android:textColor="#222222"
            android:textSize="18sp"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <!-- CONTEÚDO ROLÁVEL -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:paddingTop="15dp"
            android:paddingBottom="12dp">

            <!-- CARTÃO DO ALUNO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="95dp"
                android:orientation="vertical"
                android:padding="13dp"
                android:background="@drawable/bg_card_aluno_amarelo"
                android:elevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/imgFotoAluno"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@android:drawable/ic_menu_myplaces"
                        android:scaleType="centerCrop"
                        android:contentDescription="Foto do aluno"
                        android:background="@drawable/bg_foto_aluno"
                        android:padding="3dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="10dp">

                        <TextView
                            android:id="@+id/txtNomeAluno"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Maria Aparecida Silva"
                            android:textColor="#333333"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/txtTurmaAluno"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Turma Musicalização 01"
                            android:textColor="#555555"
                            android:textSize="10sp" />

                    </LinearLayout>

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:background="#E7BE00" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="7dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/txtCursoAluno"
                        android:text="🎵 Flauta"
                        android:textColor="#65551A"
                        android:textSize="9sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/txtProfessorAluno"
                        android:layout_marginStart="14dp"
                        android:text="👨‍🏫 Prof. João Silva"
                        android:textColor="#65551A"
                        android:textSize="9sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- FREQUÊNCIA E TURMA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <!-- FREQUÊNCIA -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_card_branco"
                    android:elevation="2dp">

                    <TextView
                        android:id="@+id/txtPorcentagem"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="92%"
                        android:textColor="#32B65A"
                        android:textSize="19sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Minha frequência"
                        android:textColor="#555555"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/txtPresencas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="23 presenças"
                        android:textColor="#777777"
                        android:textSize="9sp" />

                </LinearLayout>

                <!-- MINHA TURMA -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_card_branco"
                    android:elevation="2dp">

                    <TextView
                        android:id="@+id/txtNomeTurma"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Musicalização\n01"
                        android:textColor="#438BFF"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="0.9" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Minha turma"
                        android:textColor="#555555"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/txtColegas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10 colegas"
                        android:textColor="#777777"
                        android:textSize="9sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- PRÓXIMA AULA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_branco"
                android:elevation="2dp">

                <TextView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:gravity="center"
                    android:background="@drawable/bg_icone_aula"
                    android:text="🗓"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PRÓXIMA AULA"
                        android:textColor="#888888"
                        android:textSize="9sp"
                        android:letterSpacing="0.03" />

                    <TextView
                        android:id="@+id/txtDataAula"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Quarta-feira — 14:00"
                        android:textColor="#333333"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- AVISOS RECENTES -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="9dp"
                android:text="AVISOS RECENTES"
                android:textColor="#777777"
                android:textSize="9sp"
                android:letterSpacing="0.04" />

            <!-- Lista de avisos: uma cópia de item_aviso.xml para cada aviso -->
            <LinearLayout
                android:id="@+id/listaAvisos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </ScrollView>

    <!-- MENU INFERIOR -->
    <include layout="@layout/menu_inferior_aluno" />

</LinearLayout>
