<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAFAFA">

    <!-- CABEÇALHO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="53dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/btnVoltarAluno"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:text="‹"
            android:textColor="#222222"
            android:textSize="26sp"
            android:contentDescription="Voltar" />

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Dados do Aluno"
            android:textColor="#222222"
            android:textSize="16sp"
            android:layout_marginStart="8dp" />

        <TextView
            android:text="🔒 Somente leitura"
            android:textSize="11sp"
            android:textColor="#999999"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- BANNER AMARELO DO TOPO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#F2C900"
                android:padding="20dp">

                <ImageView
                    android:id="@+id/imgFotoDetalheAluno"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/bg_foto_aluno"
                    android:scaleType="centerCrop"
                    android:contentDescription="Foto do aluno" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtNomeDetalheAluno"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#222222"
                        tools:text="Ana Costa" />

                    <TextView
                        android:id="@+id/txtCursoDetalheAluno"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="#444444"
                        android:layout_marginTop="2dp"
                        tools:text="Musicalização 01" />

                    <TextView
                        android:id="@+id/txtInstrumentoBanner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="#555555"
                        android:layout_marginTop="2dp"
                        tools:text="🎵 Flauta" />

                </LinearLayout>

            </LinearLayout>

            <!-- CONTEÚDO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- DADOS PESSOAIS -->
                <TextView
                    android:text="DADOS PESSOAIS"
                    android:textSize="11sp"
                    android:textColor="#888888"
                    android:textStyle="bold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_branco"
                    android:elevation="1dp">

                    <!-- DATA DE NASCIMENTO -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:orientation="vertical"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DATA DE NASCIMENTO"
                            android:textColor="#AAAAAA"
                            android:textSize="9sp" />

                        <TextView
                            android:id="@+id/txtDataNascimentoAluno"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            tools:text="12/03/2014"
                            android:textColor="#333333"
                            android:textSize="13sp" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EEEEEE" />

                    <!-- INSTRUMENTO -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="INSTRUMENTO"
                                android:textColor="#AAAAAA"
                                android:textSize="9sp" />

                            <TextView
                                android:id="@+id/txtInstrumentoAluno"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                tools:text="Flauta"
                                android:textColor="#333333"
                                android:textSize="13sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EEEEEE" />

                    <!-- TURMA -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:orientation="vertical"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TURMA"
                            android:textColor="#AAAAAA"
                            android:textSize="9sp" />

                        <TextView
                            android:id="@+id/txtTurmaDetalhe"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            tools:text="Musicalização 01"
                            android:textColor="#333333"
                            android:textSize="13sp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- CONTATOS DE EMERGÊNCIA -->
                <TextView
                    android:text="CONTATOS DE EMERGÊNCIA"
                    android:textSize="11sp"
                    android:textColor="#888888"
                    android:textStyle="bold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_branco"
                    android:elevation="1dp">

                    <!-- MÃE -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="MÃE"
                                android:textColor="#AAAAAA"
                                android:textSize="9sp" />

                            <TextView
                                android:id="@+id/txtMaeAluno"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                tools:text="Patrícia Costa"
                                android:textColor="#333333"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/txtTelefoneMae"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                tools:text="(11) 98001-1111"
                                android:textColor="#666666"
                                android:textSize="12sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EEEEEE" />

                    <!-- PAI -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PAI"
                                android:textColor="#AAAAAA"
                                android:textSize="9sp" />

                            <TextView
                                android:id="@+id/txtPaiAluno"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                tools:text="Ricardo Costa"
                                android:textColor="#333333"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/txtTelefonePai"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                tools:text="(11) 97002-2222"
                                android:textColor="#666666"
                                android:textSize="12sp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <!-- OBSERVAÇÕES -->
                <TextView
                    android:text="OBSERVAÇÕES"
                    android:textSize="11sp"
                    android:textColor="#888888"
                    android:textStyle="bold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_branco"
                    android:elevation="1dp"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/txtObservacoesAluno"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="Aluna dedicada, participa ativamente."
                        android:textColor="#333333"
                        android:textSize="13sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
